PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/spendwise

# At least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=paste_a_long_random_string_here
JWT_EXPIRES_IN=1h

# Exactly 64 hex characters, used to encrypt MFA secrets. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=paste_64_hex_characters_here

MFA_ISSUER=SpendWise
CLIENT_URL=http://localhost:5173

# Email for login codes (Email OTP). With Gmail, use an App Password, not your normal password.
# If left empty during development, codes are printed in the server terminal instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=SpendWise <your.gmail@gmail.com>

# AI budget recommendations (Google Gemini). Get a free key at https://aistudio.google.com/apikey
# If empty, SpendWise still gives suggestions calculated from the user's averages.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
